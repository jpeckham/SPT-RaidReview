<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RAID_REVIEW</AssemblyName>
    <RootNamespace>RAID_REVIEW</RootNamespace>
    <Version>2.0.1</Version>
    <Authors>Ekky;Chazut</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <SPTPath Condition="'$(SPTPath)' == ''">D:\sptarkov\SPTarkov 5.0.0-BE-1.3.0.0.48484</SPTPath>
    <CorePath>$(SPTPath)/BepInEx/core</CorePath>
    <InteropPath>$(SPTPath)/BepInEx/interop</InteropPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(CorePath)/BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Core"><HintPath>$(CorePath)/BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(CorePath)/BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(CorePath)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(CorePath)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(CorePath)/Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTushonka.Reflection"><HintPath>$(SPTPath)/BepInEx/plugins/sptushonka/SPTushonka.Reflection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="$(InteropPath)/*.dll" Exclude="$(InteropPath)/Newtonsoft.Json.dll;$(InteropPath)/websocket-sharp.dll"><Private>false</Private></Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="WebSocketSharp-netstandard" Version="1.0.1" />
    <Compile Remove="tests/**/*.cs" />
    <EmbeddedResource Remove="tests/**/*" />
  </ItemGroup>
  <Target Name="StagePlugin" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath);$(TargetDir)Newtonsoft.Json.dll;$(TargetDir)websocket-sharp.dll;$(ProjectDir)../LICENSE" DestinationFolder="$(ProjectDir)Build/BepInEx/plugins/RaidReview" />
  </Target>
</Project>
